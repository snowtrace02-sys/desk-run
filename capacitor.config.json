{
  "appId": "ru.deskrun.game",
  "appName": "Побег from the desk",
  "webDir": "www",
  "backgroundColor": "#051D15",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#051D15"
  },
  "ios": {
    "backgroundColor": "#051D15",
    "contentInset": "never",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#051D15",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#051D15"
    }
  }
}